# Application Configuration
APP_NAME=CreatorFlow_AI
APP_ENV=development
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1
SECRET_KEY=replace_with_secure_random_value_in_production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=UTC

# Database Settings
DATABASE_URL=sqlite:///db.sqlite3
MONGODB_URI=
MONGODB_DATABASE=sabd_studio
POSTGRES_DB=creatorflow
POSTGRES_USER=creatorflow
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=false

# Redis & Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_MAX_RETRIES=3

# JWT & Authentication Expiries
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_SIGNING_KEY=replace_with_jwt_secret_key
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AI Providers
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.4
AI_MAX_OUTPUT_TOKENS=4000
AI_FALLBACK_PROVIDER=deterministic
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

# Gemini Provider Option
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Transcription Provider
TRANSCRIPTION_PROVIDER=whisper
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_TIMEOUT_SECONDS=600

# Image Generation
IMAGE_GENERATION_PROVIDER=dall-e-3
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=dall-e-3

# Storage Providers
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=creatorflow
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
SIGNED_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_SIZE_MB=500

# Email Delivery
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@creatorflow.ai
SUPPORT_EMAIL=support@creatorflow.ai

# Social Platform Integration Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/dashboard/integrations/youtube/callback
YOUTUBE_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/dashboard/integrations/meta/callback
META_GRAPH_API_VERSION=v19.0

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/dashboard/integrations/linkedin/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/dashboard/integrations/twitter/callback

# Monitoring & Security
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=
HEALTHCHECK_TOKEN=
FIELD_ENCRYPTION_KEY=secure_field_encryption_key_32_chars!
RATE_LIMIT_ANONYMOUS=60/hour
RATE_LIMIT_AUTHENTICATED=1000/hour
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

# Feature Flags
ENABLE_GOOGLE_AUTH=false
ENABLE_AI_GENERATION=true
ENABLE_TRANSCRIPTION=true
ENABLE_IMAGE_GENERATION=false
ENABLE_REAL_PUBLISHING=false
ENABLE_DEMO_ANALYTICS=true
ENABLE_TEAM_FEATURES=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Analytics Jobs
ANALYTICS_SYNC_INTERVAL_MINUTES=60
ANALYTICS_RETENTION_DAYS=365

# Next.js Frontend Public Environment Variables
NEXT_PUBLIC_APP_NAME=CreatorFlow AI
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_SENTRY_DSN=

APP_NAME=CreatorFlow_AI
APP_ENV=production
APP_VERSION=1.0.0
APP_URL=https://app.creatorflow.ai
FRONTEND_URL=https://app.creatorflow.ai
BACKEND_URL=https://api.creatorflow.ai
API_BASE_URL=https://api.creatorflow.ai/api/v1
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING
DEBUG=false
ALLOWED_HOSTS=api.creatorflow.ai,creatorflow-backend

DATABASE_URL=postgresql://creatorflow_user:PROD_SECURE_PASSWORD@postgres-db:5432/creatorflow_db
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sabd_studio
DB_CONN_MAX_AGE=300
DB_SSL_REQUIRE=true

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_SIGNING_KEY=PROD_SECURE_JWT_KEY

AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
TRANSCRIPTION_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
IMAGE_GENERATION_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=sabd-studio
MAX_UPLOAD_SIZE_MB=500

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

FIELD_ENCRYPTION_KEY=PROD_FIELD_ENCRYPTION_KEY_32BYTES_LEN

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
ENABLE_DEMO_ANALYTICS=true
